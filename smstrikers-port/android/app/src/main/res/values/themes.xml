<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's own dark theme, not AppCompat's: this app has exactly one screen of widgets
         and adding a support library for it would be the largest dependency in the project. -->
    <style name="Theme.Strikers" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorBackground">@color/pitch</item>
        <item name="android:windowBackground">@color/pitch</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- r157 (menu overhaul): the launcher panel (LobbyActivity) only, navy + gold; the game and the old setup screen
         keep the pitch green above. -->
    <style name="Theme.Strikers.Lobby" parent="Theme.Strikers">
        <item name="android:colorBackground">@color/lobby_navy</item>
        <item name="android:windowBackground">@color/lobby_navy</item>
        <item name="android:colorAccent">@color/lobby_gold</item>
    </style>
</resources>
