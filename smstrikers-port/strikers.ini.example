# strikers.ini, rename or copy this to strikers.ini beside the executable.

# Handheld / battery: uncomment these three together on a Steam Deck or any machine running on one.
#   fps_limit = 40
# vsync = 1 # Fifo blocks and lets the GPU idle; Mailbox renders frames the panel never shows, which
# on a battery is heat.
#   msaa      = 1
# res_scale is deliberately absent: the default already renders the Deck's panel pixel for pixel.

[display]
# Internal render resolution, as a multiple of the console's 448 rows. Unset, it follows the window;
# on a Steam Deck it is the panel's 800 rows (1.786) even when docked.
# res_scale = 2.0

# Multisampling. Init-time only. 1 is the default and 4 is the only other value worth setting.
# msaa = 1

# Anisotropic texture filtering: 1, 2, 4, 8 or 16.
# aniso = 16

# Frame rate cap in Hz, or 0 for unlimited.
# fps_limit = 59.94

# 1 waits for each refresh of your display and gives the steadiest picture. 0 makes the
# controls more responsive and keeps the frame rate up when your graphics card struggles.
# Where your system supports it, 0 still avoids tearing.
# vsync = 1

# Aspect ratio: auto, 16:9, 4:3, 21:9, any W:H, or a decimal.
# aspect = auto

# Window size, WIDTHxHEIGHT. Unset, the window opens maximised and restores to the largest
# standard 16:9 size that fits the screen.
# window_size = 1600x900

# 1 opens fullscreen and 0 a window. Unset, it is fullscreen under Steam's Game Mode (gamescope),
# which scales a window into the screen with black bars, and a window everywhere else.
# fullscreen = 1

# Stop the game when its window loses focus. 0 by default and deliberately: the attract mode and the
# demo match are worth leaving to run, and a benchmark that stopped would report nothing.
# pause_on_focus_lost = 1

# Graphics backend: auto, d3d12, vulkan, metal, opengl, opengles.
# backend = vulkan

# Shaders compiled at once, 0 to 16. 0 picks a count from the CPU cores. Set 1 if the graphics driver
# has problems at startup.
# shader_jobs = 0

[audio]
# Sound: music, effects, the stadium reverb and the movies' own tracks.
# audio = 0

# Master level, 0 to 2, in front of the limiter.
# audio_volume = 1.0

# Report at exit: ticks rendered, underruns, and whether any non-silent sample was produced; plus
# the mixer's state every two seconds.
# log_audio = 1

[input]
# Controls. Everything here is commented out and the defaults below are what you get without the
# file.
# STRIKERS_PROBE_PAD=1 prints the whole effective table at startup, which is
# also the answer to "what are my controls".

# keyboard = 1            ; 0 disables the keyboard pad

# Button art: auto follows the last input device; a named family overrides the art.
# button_prompts = auto

# Keyboard, player 1. SDL scancode names as SDL_GetScancodeName spells them: "A", "Return", "Space",
# "Left Shift", "F1", "Keypad 0". STRIKERS_PROBE_PAD=1 prints the whole effective table.
# key_a = X
# key_b = Z
# key_x = C
# key_y = V
# key_z = Space
# key_start = Return
# key_l = Q
# key_r = E
# key_dpad_up = Up
# key_dpad_down = Down
# key_dpad_left = Left
# key_dpad_right = Right
# key_stick_up = W
# key_stick_down = S
# key_stick_left = A
# key_stick_right = D
# key_cstick_up = I
# key_cstick_down = K
# key_cstick_left = J
# key_cstick_right = L

# Gamepad (all ports). Values are SDL gamepad button names: a b x y back guide start leftstick
# rightstick leftshoulder rightshoulder dpup dpdown dpleft dpright, and for triggers: lefttrigger
# righttrigger.
# pad_a = a
# pad_b = b
# pad_x = x
# pad_y = y
# pad_z = rightshoulder
# pad_start = start
# pad_l = lefttrigger
# pad_r = righttrigger
# pad_dpad_up = dpup
# pad_dpad_down = dpdown
# pad_dpad_left = dpleft
# pad_dpad_right = dpright
# pad_swap_sticks = 0     ; 1 swaps the main stick and the C-stick
# pad_deadzone = 0.15     ; 0.0 .. 0.9, fraction of stick radius
# pad_trigger_threshold = 0.5
# pad_rumble = 1          ; 0 turns rumble off on every port
# pad_rumble_strength = 100   ; 0..100

# Quest 3 Strikers: the RIGHT thumbstick at the STRIKERZ machine (franchise: the sportsbook / slots /
# roulette cabinet in your room). 1 = it moves the machine's cursor like the left one (default);
# 0 = it does nothing there (for a drifting right stick) - the left stick, the buttons, both
# triggers, the laser pointer on the screen and the 3D joystick still work. This headset only.
# machine_right_stick = 1

[paths]
# Where the game data is: either the `files` folder of an extracted disc, or a disc image.
# data = C:/games/strikers/files
# data = C:/games/strikers/Super Mario Strikers.iso

# Where the game's reports go: 1 for strikers-log.txt beside it, a file path, or console.
# log = 1
# log = console

# Menu language: english, german, french, spanish or italian, and japanese on the Japanese disc.
# Unset keeps the disc's own language. The American disc ignores this.
# language = german

[game]
# Which disc the data came from, when the data cannot say: the id is read from sys/boot.bin
# beside `files` or from an image's first bytes, and an extraction of `files` alone is taken
# as the USA disc. usa, europe or japan, or a disc id (G4QE01, G4QP01, G4QJ01).
# region = europe

# Every stadium, team and cup mode available.
# unlock_all = 1

# Quest 3 Strikers: the weather of quick matches, looks only (the game plays the same): random
# (60% clear, 15% rain, 10% snow, 15% night), clear, rain, snow, night, or off (off also turns
# the franchise calendar's weather off). The pause menu's WEATHER row replaces this once used.
# weather = random

# Quest 3 Strikers: the match's rain and snow in your own room too (MR: the Jumbotron Living Room
# and MR Tabletop), 1 = on (default) or 0 = off (then only the game's picture has its weather).
# This headset only. The pause menu's SETTINGS > ROOM > WEATHER IN MY ROOM row replaces this once used.
# room_weather = 1

# Quest 3 Strikers: the music outside matches (the launcher panel, the game's menus, the franchise
# hub): both (the CC0 lofi playlist + your own songs in Strikers/music), lofi, mine (only your
# songs; the lofi while that folder is empty) or off (the game's own menu music). Franchise mode
# starts its theme first (a song of yours named theme.* replaces it). The pause menu's MENU MUSIC
# row and the launcher's Menu music button replace this once used.
# menu_music = both
# Its level, 0 to 1, times the game's own Music Volume (Options) and audio_volume above. 0.45
# puts the lofi about as loud as the game's own menu music.
# menu_music_volume = 0.45

[debug]
# The debug overlay and menu. `menu` opens the menu straight away, `1` draws only the compact
# heads-up form.
# overlay = menu

# Force a stadium instead of letting the demo pick at random.
# force_stadium = mario_stadium

# Pin the RNG seed, so a run is reproducible.
# seed = 3
